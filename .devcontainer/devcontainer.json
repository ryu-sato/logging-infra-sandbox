// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-in-docker
{
	"name": "Docker in Docker",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:bullseye",

	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest",
			"moby": "true"
		},
		"ghcr.io/devcontainers/features/git:1": "latest",
		"ghcr.io/jsburckhardt/devcontainer-features/uv:1": "latest",
		"ghcr.io/devcontainers-extra/features/claude-code:2": {},
		"ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
			"minikube": "none"
		},
		"ghcr.io/devcontainers-extra/features/kind:1": {}
	},

	// Grafana (UI) and Loki (log push API), reachable at localhost once bootstrap.sh's
	// kubectl port-forwards are up.
	"forwardPorts": [3000, 3100],
	"portsAttributes": {
		"3000": { "label": "Grafana", "onAutoForward": "notify" },
		"3100": { "label": "Loki API", "onAutoForward": "silent" }
	},

	// Creates the kind cluster and installs Loki + Grafana; re-run on every start since
	// the cluster/port-forwards don't survive a container restart.
	"postStartCommand": "bash .devcontainer/scripts/bootstrap.sh"

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
