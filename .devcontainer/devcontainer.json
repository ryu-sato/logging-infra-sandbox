// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-in-docker
{
	"name": "Docker in Docker",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:bullseye",

	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest",
			"moby": "true"
		},
		"ghcr.io/devcontainers/features/git:1": "latest",
		"ghcr.io/jsburckhardt/devcontainer-features/uv:1": "latest",
		"ghcr.io/devcontainers-extra/features/claude-code:2": {},
		"ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
			"minikube": "none"
		},
		"ghcr.io/devcontainers-extra/features/kind:1": {},
		"ghcr.io/devcontainers-extra/features/kubie:1": {}
	},

	// Grafana (UI), Loki (log push API), and the Grafana Alloy UI, reachable at localhost
	// once bootstrap.sh's kubectl port-forwards and the Alloy container are up.
	"forwardPorts": [3000, 3100, 12345],
	"portsAttributes": {
		"3000": { "label": "Grafana", "onAutoForward": "notify" },
		"3100": { "label": "Loki API", "onAutoForward": "silent" },
		"12345": { "label": "Alloy UI", "onAutoForward": "silent" }
	},

	// Installs k9s once at container creation (no devcontainer feature exists for it).
	"postCreateCommand": "bash .devcontainer/scripts/install-k9s.sh",

	// Creates the kind cluster, installs Loki + Grafana, and starts Grafana Alloy to tail
	// Docker container logs; re-run on every start since none of this survives a restart.
	"postStartCommand": "bash .devcontainer/scripts/bootstrap.sh"

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
